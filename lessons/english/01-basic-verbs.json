    {
      "verb": "TO BE",
      "translation": "sein",
      "conjugation": "I am, you are, he/she/it is, we are, they are",
      "examples": [
        {
          "pt": "I am a student.",
          "de": "Ich bin ein Student.",
          "vocabulary": [
            {
              "pt": "student",
              "de": "Student"
            }
          ]
        },
        {
          "pt": "You are very kind.",
          "de": "Du bist sehr nett.",
